FEEDBACK_AGENT_DATA_PATH=data/sample_feedback.csv
FEEDBACK_AGENT_INDEX_PATH=.artifacts/vector_store.json
FEEDBACK_AGENT_EMBEDDING_DIM=512
# LLM provider: local (default, no API key), openai, openai_responses, anthropic, bedrock, or ollama.
FEEDBACK_AGENT_LLM_PROVIDER=local
# OpenAI-compatible provider (FEEDBACK_AGENT_LLM_PROVIDER=openai).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com
# Anthropic provider (FEEDBACK_AGENT_LLM_PROVIDER=anthropic, requires the 'anthropic' extra).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# AWS Bedrock provider (FEEDBACK_AGENT_LLM_PROVIDER=bedrock, requires the 'bedrock' extra).
# Credentials are resolved by the AWS SDK chain (env, profile, SSO, IAM role).
AWS_REGION=
AWS_BEDROCK_MODEL=anthropic.claude-3-haiku-20240307-v1:0
AWS_BEDROCK_MAX_TOKENS=1024
AWS_BEDROCK_TEMPERATURE=0.2
# Remote LLM resilience wrapper (not applied to FEEDBACK_AGENT_LLM_PROVIDER=local).
FEEDBACK_AGENT_LLM_RESILIENCE_ENABLED=true
FEEDBACK_AGENT_LLM_TIMEOUT_SECONDS=30
FEEDBACK_AGENT_LLM_RETRY_MAX_ATTEMPTS=3
FEEDBACK_AGENT_LLM_RETRY_BACKOFF_SECONDS=0.25
FEEDBACK_AGENT_LLM_CIRCUIT_FAILURE_THRESHOLD=3
FEEDBACK_AGENT_LLM_CIRCUIT_RECOVERY_SECONDS=30
# Optional semantic hallucination review. When true, the configured LLM provider
# is also used as a judge after deterministic evidence-overlap checks.
FEEDBACK_AGENT_HALLUCINATION_JUDGE_ENABLED=false
# Ollama provider (FEEDBACK_AGENT_LLM_PROVIDER=ollama, local server, no API key).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
FEEDBACK_AGENT_CONVERSATION_STORE_PATH=.artifacts/conversations
# Telemetry is disabled by default. Use backend=jsonl for local event logs or
# backend=opentelemetry with the optional 'otel' extra and a configured OTel SDK/exporter.
FEEDBACK_AGENT_TELEMETRY_ENABLED=false
FEEDBACK_AGENT_TELEMETRY_BACKEND=jsonl
FEEDBACK_AGENT_TELEMETRY_PATH=.artifacts/telemetry.jsonl
FEEDBACK_AGENT_TELEMETRY_SERVICE_NAME=feedback-intelligence-agent
# Comma-separated browser origins allowed to call the API (CORS).
# Use "*" to allow any origin for local demos, or leave empty to disable CORS.
FEEDBACK_AGENT_CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173
